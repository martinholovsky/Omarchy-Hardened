#!/usr/bin/env bash
# {{ ansible_managed }}
# aegis-agent: run an AI agent in a rootless Podman container that sees only
# the current project directory (D-07). No $HOME, no capabilities, no new
# privileges, no user namespaces inside (D-01).
#
# Usage: aegis-agent [--image IMAGE@sha256:DIGEST] [--network pasta|none] -- COMMAND [ARGS...]
set -euo pipefail

image=${AEGIS_AGENT_IMAGE:-{{ aegis_agent_image | quote }}}
network={{ aegis_agent_network | quote }}

die() { printf 'aegis-agent: %s\n' "$*" >&2; exit 2; }

while (($#)); do
  case $1 in
    --image) image=${2:?--image needs a value}; shift 2 ;;
    --network) network=${2:?--network needs a value}; shift 2 ;;
    -h | --help) sed -n '3,8p' "$0"; exit 0 ;;
    --) shift; break ;;
    *) die "unknown option '$1' (did you forget '--'?)" ;;
  esac
done
(($#)) || die "no command given"
[[ -n $image ]] || die "no image: pass --image or set aegis_agent_image"
[[ $image == *@sha256:* ]] || die "image must be pinned by digest (IMAGE@sha256:...)"
[[ $network == pasta || $network == none ]] || die "--network must be pasta or none"
((EUID != 0)) || die "run as your user, not root (rootless Podman)"

project=$(pwd -P)
case $project in
  / | "$HOME" | "$(dirname "$HOME")") die "run from a project directory, not $project" ;;
esac

tty=()
if [[ -t 0 ]]; then tty=(-t); fi

exec podman run --rm -i "${tty[@]}" \
  --userns=keep-id --cap-drop=ALL --security-opt=no-new-privileges \
  --security-opt=seccomp={{ aegis_agent_seccomp | quote }} \
  --read-only --tmpfs /tmp:rw,nosuid,nodev,size=1g --env HOME=/tmp/home \
  --network="$network" --memory={{ aegis_agent_memory | quote }} --pids-limit={{ aegis_agent_pids_limit }} \
  --volume "$project:/work:rw" --workdir /work \
  "$image" "$@"
